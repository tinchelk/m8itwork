{
  "name": "m8itwork-frontends",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "npm run dev:customer",
    "dev:customer": "npm run dev --workspace @m8itwork/customer",
    "dev:admin": "npm run dev --workspace @m8itwork/admin",
    "build": "npm run build --workspaces --if-present",
    "build:customer": "npm run build --workspace @m8itwork/customer",
    "build:admin": "npm run build --workspace @m8itwork/admin",
    "start": "npm run start --workspace @m8itwork/customer",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "24.5.2",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "eslint": "9.36.0",
    "eslint-config-next": "^16.3.8",
    "typescript": "5.9.2"
  },
  "overrides": {
    "postcss": "^8.5.10"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
