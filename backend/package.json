{
  "name": "m8itwork-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "leads": "tsx scripts/leads.ts",
    "lead:status": "tsx scripts/lead-status.ts",
    "github:setup": "tsx scripts/github-setup.ts",
    "cleanup": "tsx scripts/cleanup.ts",
    "worker:run": "tsx src/worker/main.ts run",
    "worker:doctor": "tsx src/worker/main.ts doctor",
    "worker:configure": "tsx src/worker/main.ts configure"
  },
  "dependencies": {
    "@fastify/cookie": "10.0.1",
    "@fastify/cors": "11.1.0",
    "@fastify/helmet": "13.0.2",
    "@fastify/proxy-addr": "5.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@prisma/client": "6.19.3",
    "dotenv": "17.2.2",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "stripe": "^23.0.0",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@types/node": "24.5.2",
    "eslint": "9.36.0",
    "prisma": "6.19.3",
    "tsx": "4.20.6",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0"
  }
}
