generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ReviewSession {
  id                   String       @id
  expiresAt            DateTime
  oauthStateHash       String?      @unique
  oauthAttemptId       String?
  oauthPurpose         String?
  oauthAccountId       String?
  oauthNonceHash       String?
  accountSessionId     String?
  selectedInspectionId String?      @db.Uuid
  oauthExpiresAt       DateTime?
  verifierEncrypted    String?
  tokenEncrypted       String?
  tokenExpiresAt       DateTime?
  githubLogin          String?
  inspections          Inspection[]
  createdAt            DateTime     @default(now())

  @@index([expiresAt])
}

model Account {
  id          String           @id @default(uuid()) @db.Uuid
  githubId    String?          @unique
  githubLogin String?
  email       String?          @unique
  emailVerifiedAt DateTime?
  passwordHash String?
  googleId    String?          @unique
  displayName String?
  sessions    AccountSession[]
  projects    Project[]
  inspections Inspection[]
  tokens      AccountToken[]
  reviewWorkers ReviewWorker[]
  createdAt   DateTime         @default(now())
}

model AccountToken {
  id        String   @id
  accountId String   @db.Uuid
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  purpose   String
  pendingPasswordHash String?
  pendingDisplayName String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([accountId, purpose])
  @@index([expiresAt])
}

model AuthThrottle {
  id        String   @id
  count     Int
  expiresAt DateTime
  @@index([expiresAt])
}

model AccountSession {
  id        String   @id
  accountId String   @db.Uuid
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@index([accountId])
}

model Project {
  id                    String           @id @default(uuid()) @db.Uuid
  accountId             String           @db.Uuid
  account               Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name                  String
  contactEmail          String
  platform              String
  demoUrl               String?
  summary               String
  accessNote            String?
  repositoryUrl         String?
  inspectionReport      Json?
  aiReviewConsentAt     DateTime?
  aiReviewConsentVersion String?
  stage                 String           @default("DRAFT")
  version               Int              @default(1)
  reviewSummary         String?
  verificationSummary   String?
  customerReadAt        DateTime?
  teamReadAt            DateTime?
  customerLastMessageAt DateTime?
  teamLastMessageAt     DateTime?
  currentProposalId     String?          @db.Uuid
  requests              ProjectRequest[]
  proposals             Proposal[]
  updates               ProjectUpdate[]
  messages              ProjectMessage[]
  notes                 TeamNote[]
  workItems             WorkItem[]
  reviewJobs            ReviewJob[]
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([accountId, updatedAt])
  @@index([stage, updatedAt])
}

model ReviewWorker {
  id String @id @default(uuid()) @db.Uuid
  name String
  tokenHash String @unique
  operatorId String @db.Uuid
  operator Account @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  lastSeenAt DateTime?
  revokedAt DateTime?
  providerStatus Json?
  statusAt DateTime?
  remoteLogin Boolean @default(false)
  loginRequest Json?
  jobs ReviewJob[]
}

model ReviewJob {
  id String @id @db.Uuid
  projectId String @db.Uuid
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  provider String
  status String @default("QUEUED")
  commit String
  repositoryUrl String
  inputDigest String
  requestSnapshot Json
  attemptId String? @unique @db.Uuid
  attempts Int @default(0)
  workerId String? @db.Uuid
  worker ReviewWorker? @relation(fields: [workerId], references: [id], onDelete: SetNull)
  startedAt DateTime?
  leaseExpiresAt DateTime?
  completedAt DateTime?
  sourceSessionId String?
  sourceConnectionHash String?
  evidencePaths Json?
  coverage Json?
  result Json?
  errorCode String?
  instructions String?
  parentJobId String? @db.Uuid
  comparisonId String? @db.Uuid
  previousTurns Json?
  activity Json?
  activityOmitted Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, createdAt])
  @@index([projectId, createdAt])
  @@unique([comparisonId, provider])
}

model ProjectRequest {
  id           String   @id @default(uuid()) @db.Uuid
  projectId    String   @db.Uuid
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind         String
  title        String
  detail       String
  referenceUrl String?
  createdAt    DateTime @default(now())

  @@index([projectId, createdAt])
}

model Proposal {
  id           String             @id @default(uuid()) @db.Uuid
  projectId    String             @db.Uuid
  project      Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version      Int
  scope        String
  acceptance   String
  amountCents  Int
  currency     String
  deliveryDate DateTime           @db.Date
  assumptions  String
  approvedAt   DateTime?
  milestones   PaymentMilestone[]
  createdAt    DateTime           @default(now())

  @@unique([projectId, version])
}

model ProjectMessage {
  id         String   @id @db.Uuid
  projectId  String   @db.Uuid
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId   String   @db.Uuid
  authorRole String
  authorName String
  body       String
  createdAt  DateTime @default(now())

  @@index([projectId, createdAt, id])
}

model TeamNote {
  id         String   @id @db.Uuid
  projectId  String   @db.Uuid
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorName String
  body       String
  createdAt  DateTime @default(now())

  @@index([projectId, createdAt])
}

model WorkItem {
  id          String   @id @db.Uuid
  projectId   String   @db.Uuid
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  detail      String
  status      String   @default("TODO")
  evidence    String?
  evidenceUrl String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId, createdAt])
}

model PaymentMilestone {
  id            String           @id @default(uuid()) @db.Uuid
  proposalId    String           @db.Uuid
  proposal      Proposal         @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  position      Int
  label         String
  amountCents   Int
  dueWhen       String
  releasedAt    DateTime?
  paidAt        DateTime?
  paidCents     Int              @default(0)
  refundedCents Int              @default(0)
  disputed      Boolean          @default(false)
  attempts      PaymentAttempt[]

  @@unique([proposalId, position])
}

model PaymentAttempt {
  id                    String           @id @default(uuid()) @db.Uuid
  milestoneId           String           @db.Uuid
  milestone             PaymentMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  status                String           @default("CREATING")
  mode                  String
  amountCents           Int
  currency              String
  stripeSessionId       String?          @unique
  stripePaymentIntentId String?          @unique
  checkoutUrl           String?
  receiptUrl            String?
  refundedCents         Int              @default(0)
  disputed              Boolean          @default(false)
  disputeEventCreated   Int              @default(0)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([milestoneId, createdAt])
}

model PaymentEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())
}

model ProjectUpdate {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author    String
  title     String
  detail    String
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
}

model Inspection {
  id        String        @id @default(uuid()) @db.Uuid
  sessionId String
  session   ReviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  accountId String?       @db.Uuid
  account   Account?      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  report    Json
  createdAt DateTime      @default(now())

  @@index([sessionId, createdAt])
  @@index([accountId])
}

model Submission {
  id               String   @id @default(uuid()) @db.Uuid
  name             String
  email            String
  projectName      String
  platform         String
  demoUrl          String?
  problem          String
  workflows        String[]
  inspectionReport Json?
  status           String   @default("NEW")
  createdAt        DateTime @default(now())

  @@index([createdAt])
}
