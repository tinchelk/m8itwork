DATABASE_URL=postgresql://m8itwork:m8itwork_local@localhost:55434/m8itwork?schema=public
PORT=3121
FRONTEND_ORIGIN=http://localhost:3120
ADMIN_ORIGIN=http://localhost:3123
PUBLIC_API_URL=http://localhost:3121
# Railway HTTP edge only: use its overwritten X-Real-IP. Leave 0 elsewhere.
TRUST_PROXY_HOPS=0
# Optional current Cloudflare CIDRs (comma-separated), for proxied custom domains.
# Trust CF-Connecting-IP only when the Railway peer matches these ranges.
CLOUDFLARE_PROXY_RANGES=
# Generate with: openssl rand -base64 32
# Required only when enabling private GitHub connections. Never commit real credentials.
TOKEN_ENCRYPTION_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_SLUG=
# Dedicated Google web OAuth client. Callback: PUBLIC_API_URL/v1/auth/google/callback.
# Requires TOKEN_ENCRYPTION_KEY. Use both values or leave both blank.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Dedicated, domain-scoped Resend sending key and verified sender.
RESEND_API_KEY=
EMAIL_FROM=
# Explicitly trusted operators, using stable GitHub numeric user IDs (not usernames).
OPERATOR_GITHUB_IDS=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
